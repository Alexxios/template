# Generated by scripts/sync_templates.py; edit templates/validation/sourcecraft.yaml.jinja instead.
on:
  push:
    - workflows: [check-repository{% for item in templates %}, validate-[[ item.template ]]{% endfor %}]
      filter:
        branches: [main, master]
  pull_request:
    - workflows: [check-repository{% for item in templates %}, validate-[[ item.template ]]{% endfor %}]

workflows:
  check-repository:
    runs_on: serverless
    tasks:
      - name: check
        cubes:
          - name: test-lint-docs
            image: docker.io/library/python:3.14-slim
            script:
              - |
                set -eu
                apt-get update && apt-get install -y --no-install-recommends make
                python -m pip install uv
                make bootstrap
                make check
{% for item in templates %}

  validate-[[ item.template ]]:
    runs_on: serverless
    tasks:
      - name: generate-and-validate
        cubes:
          - name: create-repo
            image: docker.io/library/python:3.14-slim
            env:
              SOURCECRAFT_ORG_SLUG: lexxi-0
              SOURCECRAFT_API_TOKEN: ${{ secrets.ci }}
            script:
              - |
                set -eu
                REPO_SLUG="ci-[[ item.template ]]-${SOURCECRAFT_ORG_SLUG}-$(date +%s)-$$"
                python scripts/sourcecraft_repo.py create \
                  --org-slug "$SOURCECRAFT_ORG_SLUG" --repo-slug "$REPO_SLUG" \
                  --visibility private --description "Ephemeral [[ item.template ]] template validation"
                echo "$REPO_SLUG" > .ci_[[ item.package ]]_repo_slug

          - name: scaffold-and-push
            image: docker.io/library/python:3.14-slim
            env:
              SOURCECRAFT_ORG_SLUG: lexxi-0
              SOURCECRAFT_API_TOKEN: ${{ secrets.ci }}
            script:
              - |
                set -eu
                REPO_SLUG="$(cat .ci_[[ item.package ]]_repo_slug)"
                TEMPLATE_DIR="$(pwd)"
                PROJECT_DIR="$(mktemp -d)/ci-test-project"
                apt-get update && apt-get install -y --no-install-recommends git
                python -m pip install uv
                uv sync --extra dev
                uv run python -m tests.[[ item.package ]] render "$PROJECT_DIR" --ci sourcecraft
                uv run python -m tests.[[ item.package ]] scaffold "$PROJECT_DIR"
                cd "$PROJECT_DIR"
                test -f .sourcecraft/ci.yaml
                test ! -e .github
                git init -b main
                git config user.name "CI Bot"
                git config user.email "ci@sourcecraft.dev"
                git add -A
                git commit -m "Scaffold [[ item.template ]] integration fixture"
                git remote add origin "https://git@git.sourcecraft.dev/${SOURCECRAFT_ORG_SLUG}/${REPO_SLUG}.git"
                git -c credential.helper='!f() { echo "username=git"; echo "password=$SOURCECRAFT_API_TOKEN"; }; f' push -u origin main
                touch "$TEMPLATE_DIR/.ci_[[ item.package ]]_pushed"

          - name: wait-for-ci
            image: docker.io/library/python:3.14-slim
            env:
              SOURCECRAFT_ORG_SLUG: lexxi-0
              SOURCECRAFT_API_TOKEN: ${{ secrets.ci }}
            script:
              - |
                set -eu
                python scripts/sourcecraft_repo.py cicd-wait \
                  --org-slug "$SOURCECRAFT_ORG_SLUG" --repo-slug "$(cat .ci_[[ item.package ]]_repo_slug)" \
                  --polling-interval 15 --max-attempts 120

          - name: collect-reports
            image: docker.io/library/python:3.14-slim
            if: always()
            env:
              SOURCECRAFT_ORG_SLUG: lexxi-0
              SOURCECRAFT_API_TOKEN: ${{ secrets.ci }}
            script:
              - |
                set -eu
                if [ -f .ci_[[ item.package ]]_pushed ]; then
{% for artifact in item.sourcecraft.artifacts %}
                  python scripts/sourcecraft_repo.py cicd-artifacts \
                    --org-slug "$SOURCECRAFT_ORG_SLUG" --repo-slug "$(cat .ci_[[ item.package ]]_repo_slug)" \
                    --workflow-slug [[ item.sourcecraft.workflow ]] --task-slug [[ artifact.task ]] --cube-slug [[ artifact.cube ]] \
                    --output-dir [[ item.template ]]-ci
{% for path in artifact.paths %}
                  test -s [[ item.template ]]-ci/[[ path ]]
{% endfor %}
{% endfor %}
                fi
            artifacts:
              paths:
{% for artifact in item.sourcecraft.artifacts %}
{% for path in artifact.paths %}
                - ./[[ item.template ]]-ci/[[ path ]]
{% endfor %}
{% endfor %}

          - name: delete-repo
            image: docker.io/library/python:3.14-slim
            if: always()
            env:
              SOURCECRAFT_ORG_SLUG: lexxi-0
              SOURCECRAFT_API_TOKEN: ${{ secrets.ci }}
            script:
              - |
                set -eu
                if [ -f .ci_[[ item.package ]]_repo_slug ]; then
                  python scripts/sourcecraft_repo.py delete \
                    --org-slug "$SOURCECRAFT_ORG_SLUG" --repo-slug "$(cat .ci_[[ item.package ]]_repo_slug)"
                fi
{% endfor %}
