# Generated by scripts/sync_templates.py; edit templates/validation/github.yml.jinja instead.
name: Validate [[ template ]]

on:
  push:
    branches: [main, master]
    paths:
{% for path in github_paths %}
      - "[[ path ]]"
{% endfor %}
  pull_request:
    paths:
{% for path in github_paths %}
      - "[[ path ]]"
{% endfor %}
  workflow_dispatch:

permissions:
  contents: read

jobs:
  validate:
    uses: ./.github/workflows/template-validation.yml
    with:
      template: "[[ template ]]"
      package: "[[ package ]]"
      push_workflow: "[[ github.push_workflow ]]"
      pull_request_workflow: "[[ github.pull_request_workflow ]]"
      push_artifact: "[[ github.push_artifact ]]"
      pull_request_artifact: "[[ github.pull_request_artifact ]]"
      push_artifact_format: "[[ github.push_artifact_format ]]"
      enable_pages: [[ github.enable_pages | default(false) | lower ]]
      documentation_artifact: "[[ github.documentation_artifact | default('documentation') ]]"
    secrets:
      CI_GITHUB_TOKEN: ${{ secrets.CI_GITHUB_TOKEN }}
