# Generated by scripts/sync_templates.py; edit templates/validation/pages.yml.jinja instead.
name: Publish documentation

on:
  workflow_run:
    workflows:
      - Check metatemplate
{% for item in templates %}
      - Validate [[ item.template ]]
{% endfor %}
    types: [completed]
  workflow_dispatch:

permissions:
  contents: read

# Serialize the entire build and deployment so a late validation cannot replace
# a newer aggregate with a snapshot assembled before the other validators finished.
concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  build:
    if: >-
      ${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&
          (github.event_name == 'workflow_dispatch' ||
           (github.event.workflow_run.head_branch == github.event.repository.default_branch &&
            github.event.workflow_run.head_repository.full_name == github.repository &&
            contains(fromJSON('["push", "workflow_dispatch"]'), github.event.workflow_run.event))) }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      actions: read
      pages: read
    steps:
      - uses: actions/checkout@v7
        with:
          # Always assemble the current default branch, even for a delayed run.
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false
      - uses: actions/setup-python@v7
        with:
          python-version: "3.14"
      - uses: actions/configure-pages@v5
        id: pages
      - name: Install documentation tools
        run: |
          python -m pip install uv
          uv sync --extra docs
      - name: Fetch generated sites and build the collection
        env:
          GH_TOKEN: ${{ github.token }}
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          SITE_URL: ${{ steps.pages.outputs.base_url }}
        run: >-
          uv run python -m scripts.build_pages
          --repository "$GITHUB_REPOSITORY"
          --branch "$DEFAULT_BRANCH"
          --site-url "$SITE_URL"
      - uses: actions/upload-pages-artifact@v5
        with:
          path: site/

  deploy:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/deploy-pages@v5
        id: deployment
